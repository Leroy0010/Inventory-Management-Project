# Development Environment Variables
# Copy this file to .env.dev and update with your values

# Database Configuration
POSTGRES_DB=InventoryManagementDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# OAuth2 Configuration (Development)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google

# JWT Configuration
JWT_SECRET=dev_jwt_secret_key_very_long_and_secure_at_least_256_bits
JWT_EXPIRATION=1800000

# Frontend Configuration
FRONTEND_BASE_URL=http://localhost:3000

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Mail Configuration (Optional for development)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# VAPID Keys (Optional for development)
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key

# AWS S3 Configuration (Optional for development)
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_aws_access_key
AWS_S3_SECRET_KEY=your_aws_secret_key

# Google Drive Configuration (Optional for development)
GOOGLE_DRIVE_CREDENTIALS_CLASS_PATH=credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
