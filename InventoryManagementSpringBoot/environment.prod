# Production Environment Variables Template
# Copy this file to .env and update with your production values

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://database:5432/InventoryManagementDB
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here_at_least_256_bits
JWT_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=7200000
JWT_MAX_TOKENS_PER_USER=5
JWT_COOKIE_NAME=jwt
JWT_REFRESH_COOKIE_NAME=refreshToken
JWT_COOKIE_DOMAIN=yourdomain.com
JWT_COOKIE_PATH=/
JWT_COOKIE_SECURE=true
JWT_COOKIE_HTTP_ONLY=true
JWT_COOKIE_SAME_SITE=Strict

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://yourdomain.com/login/oauth2/code/google

# Email Configuration
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLED=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_SMTP_SSL_PROTOCOLS=TLSv1.2

# Frontend Configuration
FRONTEND_BASE_URL=https://yourdomain.com

# Google Drive Configuration
GOOGLE_DRIVE_CREDENTIALS_CLASS_PATH=/run/secrets/credentials.json
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id_here

# AWS S3 Configuration
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=your_aws_access_key_here
AWS_S3_SECRET_KEY=your_aws_secret_key_here

# VAPID Keys for Push Notifications
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=
COOKIE_SECURE=true

# Database Configuration for Docker
POSTGRES_DB=InventoryManagementDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
